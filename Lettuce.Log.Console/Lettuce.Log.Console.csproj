<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Lettuce.Log.Console</Title>
    <Authors>Lettuce Studios</Authors>
    <Description>Logging destination that writes to the System.Console with colors</Description>
    <Version>3.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lettuce.Log.Core" Version="4.0.0" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.5" Condition="'$(TargetFramework)' == 'netstandard2.1'"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
